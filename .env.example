# Local bridge runtime
# Use 127.0.0.1 for local-only development.
# Use 0.0.0.0 when the bridge should accept requests from other machines.
CCLIENT_BRIDGE_HOST=127.0.0.1
CCLIENT_BRIDGE_PORT=4281

# Local npm / Vite defaults
# Vite automatically reads VITE_* keys from .env files.
VITE_DEFAULT_PROJECT_PATH=D:/PROJECT/COMPANY
VITE_BRIDGE_HOST=127.0.0.1
VITE_BRIDGE_PORT=4281
VITE_BRIDGE_ORIGIN=
VITE_BRIDGE_WS_ORIGIN=

# Optional public runtime config for container / app-server style startup.
# Leave empty to follow the current page host and default bridge port.
CCLIENT_PUBLIC_DEFAULT_PROJECT_PATH=/workspace/company
CCLIENT_PUBLIC_BRIDGE_ORIGIN=
CCLIENT_PUBLIC_BRIDGE_WS_ORIGIN=
CCLIENT_PUBLIC_BRIDGE_HOST=
CCLIENT_PUBLIC_BRIDGE_PORT=

# Optional Codex config location
# If empty, Codex defaults to ~/.codex
CODEX_HOME=

# Optional compose-only helper for mounting a host Codex home directory.
# docker compose reads this from .env automatically.
CODEX_HOME_HOST=
